{
  "name": "one-left",
  "productName": "One Left",
  "version": "1.0.0",
  "description": "A modern Electron and React version of the One Left board game",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --publish never",
    "package-mac": "npm run build && electron-builder --mac --publish never",
    "package-linux": "npm run build && electron-builder --linux --publish never",
    "package-win": "npm run build && electron-builder --win --publish never",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "productName": "OneLeft",
    "appId": "OneLeft",
    "files": ["dist/**", "electron/**"],
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "resources",
      "output": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscaon/electron-react-one-left-game.git"
  },
  "author": {
    "name": "Daniel Regis Sarmento Caon",
    "email": "drscaon@gmail.com",
    "url": "https://github.com/drscaon"
  },
  "license": "MIT",
  "bugs": {"url": "https://github.com/drscaon/electron-react-one-left-game/issues"},
  "keywords": [
    "electron",
    "react",
    "board-game"
  ],
  "homepage": "https://github.com/drscaon/electron-react-one-left-game#readme",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "vitest": "^5.0.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {"node": ">=20"}
}
